{
  "name": "indicator-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@tanstack/react-query": "^5.108.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lightweight-charts": "^5.3.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/build-chart-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:core-purity && npm test -- --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/server/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|zustand)"
    ],
    "collectCoverageFrom": [
      "indicators/**/*.ts",
      "research/**/*.ts",
      "simulator/**/*.ts",
      "news/**/*.ts",
      "ai/**/*.ts",
      "market-data/**/*.ts",
      "security/**/*.ts",
      "notifications/**/*.ts",
      "!**/*.d.ts"
    ]
  }
}
